# Backend base URL. Falls back to http://localhost:8080 when unset.
# Replace with your dev machine's LAN IP to sign in from a device or emulator.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Optional WebSocket override. Defaults to EXPO_PUBLIC_API_URL with http
# swapped for ws and /ws appended. See ../docs/websocket.md.
EXPO_PUBLIC_WS_URL=

# Google OAuth client IDs from Google Cloud Console.
# The iOS client (bundle ID com.adnatecodes.chirp) and the web client.
# The web client is what the Android SDK uses to mint the id_token, so
# no Android-specific variable exists. Both IDs must appear in the
# server's GOOGLE_AUDIENCES list.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
