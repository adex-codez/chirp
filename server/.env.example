HOST=0.0.0.0
PORT=8080
GIN_MODE=debug
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
# Required in release mode. Outside release, a dev-only default is used.
JWT_SECRET=dev-only-change-me
# Social sign-in audiences. Apple: the app's bundle ID (or Services ID for
# web flows). Google: comma-separated OAuth client IDs (iOS, Android, web).
# A provider with no audience configured rejects sign-ins.
APPLE_AUDIENCE=
GOOGLE_AUDIENCES=
# Transactional mail via Sendlib REST API. Empty SENDLIB_API_KEY disables
# sending (codes stay in API responses outside release mode).
SENDLIB_API_KEY=
SENDLIB_FROM=hello@chirp.app
# Optional override; defaults to https://sendlib.samueltuoyo.com/api/send.
SENDLIB_BASE_URL=
