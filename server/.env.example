HOST=0.0.0.0
PORT=8080
GIN_MODE=debug
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
# Required in release mode. Outside release, a dev-only default is used.
JWT_SECRET=dev-only-change-me
# Social sign-in audiences. Apple: the app's bundle ID (or Services ID for
# web flows). Google: comma-separated OAuth client IDs (iOS, Android, web).
# A provider with no audience configured rejects sign-ins.
APPLE_AUDIENCE=
GOOGLE_AUDIENCES=
# Transactional mail via Sendlib REST API. Empty SENDLIB_API_KEY disables
# sending (codes stay in API responses outside release mode).
SENDLIB_API_KEY=
SENDLIB_FROM=hello@chirp.app
# Optional override; defaults to https://sendlib.samueltuoyo.com/api/send.
SENDLIB_BASE_URL=

# Minimum severity to emit: debug, info, warn or error.
LOG_LEVEL=info
# Encoder for log lines: json for shipping to a collector, text for terminals.
LOG_FORMAT=json
# Deployment environment recorded on every line.
APP_ENV=development

# All five empty disables picture uploads. Partial configuration fails startup.
# Use a public bucket origin, not the S3 API endpoint. See ../docs/profile-pictures.md.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Browser origins allowed to open the /ws event socket, comma-separated.
# A handshake carrying an Authorization header is native and skips this
# filter. Empty allows localhost dev servers in non-release mode and denies
# every other browser origin. See ../docs/websocket.md.
WS_ALLOWED_ORIGINS=
